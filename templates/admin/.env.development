# 由 create-frame-me 写入问答端口；本仓模板内 dev 时回落 5173
FM_PORT={{port}}

# SSO 授权端点（浏览器可达的 frame-me-sso 地址）
VITE_SSO_AUTHORIZE_URL=http://localhost:10010/api/auth/authorize
# 本应用在 SSO 注册的 appId
VITE_SSO_APP_ID=fm-internal-admin

# RP 后端（集成 frame-me-sso-starter）：/index 落地页 + /api/auth/sso-login + 业务接口
VITE_PROXY_BACKEND=http://localhost:8080
# 审计服务（演示页数据源）
VITE_PROXY_AUDIT=http://localhost:10020
