{
  "name": "@frame-me/create",
  "version": "0.2.1",
  "description": "npm init @frame-me —— frame-me 管理后台工程生成器",
  "type": "module",
  "bin": {
    "create-frame-me": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "sync-template": "node scripts/sync-template.mjs",
    "prepack": "pnpm build && pnpm sync-template"
  },
  "devDependencies": {
    "@frame-me/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
