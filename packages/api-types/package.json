{
  "name": "@frame-me/api-types",
  "version": "0.1.3",
  "description": "frame-me-gen-api：从后端 OpenAPI（/v3/api-docs）生成 TS 契约类型，多服务分文件",
  "type": "module",
  "bin": {
    "frame-me-gen-api": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@frame-me/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
